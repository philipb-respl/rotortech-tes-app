# Non-secret Cloud Functions params, loaded for every project (see
# docs/SETUP.md). Real per-project values can instead go in a
# git-ignored functions/.env.local or functions/.env.<project-id> — see
# https://firebase.google.com/docs/functions/config-env for precedence.
# Left empty here so a fresh clone / the emulator boots without an
# interactive prompt; saveTesPdf() raises a clear error if a Drive save is
# attempted before this is actually set.
DRIVE_ROOT_FOLDER_ID=
