# Non-secret Cloud Functions params, loaded for every project (see
# docs/SETUP.md). Per-project overrides can go in a git-ignored
# functions/.env.local or functions/.env.<project-id> — see
# https://firebase.google.com/docs/functions/config-env for precedence.
#
# Drive folder that TES PDFs are filed under, as <root>/TES Settlements/
# {year}/{employee}/. This is an opaque identifier, not a credential —
# access is granted by sharing the folder with the service account, so the
# ID alone gets nobody in. The actual credential is the
# DRIVE_SERVICE_ACCOUNT_KEY secret, which is never committed.
DRIVE_ROOT_FOLDER_ID=17MLn-AYy7T9nmb7MB4eVTEtxUR7s6kdx
