# Copy to .env.local (Expo loads it automatically). Same web app config as
# apps/web/.env.example — get it from Firebase Console → Project settings
# → General → Your apps → Web app (or `firebase apps:sdkconfig web`).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# true to talk to a locally running `npm run emulators` instead of the real
# project — see docs/SETUP.md. EMULATOR_HOST must be your dev machine's LAN
# IP when testing on a physical device or the Android emulator (10.0.2.2
# for the Android emulator specifically); localhost only works in a web
# preview or iOS simulator on the same machine.
EXPO_PUBLIC_USE_EMULATORS=true
EXPO_PUBLIC_EMULATOR_HOST=localhost
