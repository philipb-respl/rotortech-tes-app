# Copy to .env.local and fill in from Firebase Console → Project settings
# → General → Your apps → Web app (or `firebase apps:sdkconfig web`).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true to talk to a locally running `npm run emulators` instead of the
# real project — see docs/SETUP.md.
VITE_USE_EMULATORS=true
