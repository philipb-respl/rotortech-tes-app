# Copy to .env.local and fill in from the Supabase dashboard →
# Project Settings → API. Only VITE_-prefixed vars reach the bundle.
#
# The publishable key is not a secret: it identifies the project and grants
# nothing on its own. Every read and write is decided by row-level security
# against the signed-in user's JWT. Never put the *secret* (service_role)
# key here — it bypasses RLS entirely and must stay server-side.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Older projects label the same key "anon"; either name is accepted.
# VITE_SUPABASE_ANON_KEY=
